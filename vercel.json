{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": "web",
  "installCommand": "",
  "buildCommand": "cp SKILL.md web/SKILL.md",
  "framework": null,
  "headers": [
    {
      "source": "/SKILL.md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    }
  ]
}
